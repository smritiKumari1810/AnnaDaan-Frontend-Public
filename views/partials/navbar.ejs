<header class="navbar">
  <div class="container">
    <a href="/" class="brand"><i class="ph-fill ph-plant leaf"></i> AnnaDaan</a>
    <nav class="nav-links">
      <a href="/listings"><i class="ph ph-storefront"></i> <span class="label">Browse</span></a>
      <a href="/forecast"><i class="ph ph-chart-line-up"></i> <span class="label">Forecast</span></a>

      <% if (user) { %>
        <% if (user.role === "farmer") { %>
          <a href="/farmer"><i class="ph ph-tractor"></i> <span class="label">My farm</span></a>
          <span class="role-pill role-farmer">Farmer</span>
        <% } else if (user.role === "buyer") { %>
          <a href="/buyer"><i class="ph ph-shopping-bag"></i> <span class="label">My orders</span></a>
          <span class="role-pill role-buyer">Buyer</span>
        <% } else { %>
          <a href="/admin-dashboard" class="btn btn-outline"><i class="ph ph-user-gear"></i> <span class="label">Admin</span></a>
          <span class="role-pill role-admin" style="background:#e2e8f0;color:var(--ink);border:1px solid #cbd5e1;">Admin</span>
        <% } %>
        <form action="/logout" method="POST" style="display:inline">
          <button class="btn btn-outline" type="submit">
            <i class="ph ph-sign-out"></i> <span class="label">Log out</span>
          </button>
        </form>
      <% } else { %>
        <a href="/login"><span class="ico">🔑</span> <span class="label">Log in</span></a>
        <a class="btn btn-accent" href="/signup" style="padding:.5rem 1.1rem;font-size:.95rem"><span class="label">Sign up</span><span class="ico" aria-hidden="true">+</span></a>
      <% } %>
    </nav>
  </div>
</header>
