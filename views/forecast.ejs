<%- include("partials/header") %>
<%- include("partials/navbar") %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<section class="section">
  <div class="container">
    <div class="dash-head farmer">
      <h1>📈 Demand forecast</h1>
      <p>Predicted demand for key crops — plan what to grow and when.</p>
    </div>

    <div class="card card-pad">
      <h2 style="margin-top:0">Predicted demand trend</h2>
      <p class="meta">Data updates as the forecasting model learns. Values are estimated units of demand.</p>

      <div id="forecast-loader" class="loader">
        <span class="spinner"></span> Loading forecast…
      </div>
      <div id="forecast-error" class="alert hidden"></div>

      <canvas id="forecast-chart" class="hidden" height="120"></canvas>
    </div>

    <p class="meta mt-2">
      ℹ️ This chart reads from <code>/api/forecast</code>, currently a stub. The real
      ML model output will replace it without any frontend changes.
    </p>
  </div>
</section>

<script src="/js/forecast.js"></script>

<%- include("partials/footer") %>
