<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="hero">
  <div class="container">
    <div>
      <p class="eyebrow">Direct from the farm</p>
      <h1 class="heroh1">Fair prices for farmers.<br />Fresh produce for buyers.</h1>
      <p class="lead">
        AnnaDaan connects farmers and farmer groups (FPOs) straight to buyers
        no middlemen taking a cut. Farmers earn more. Buyers pay less. Everyone wins.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/signup?role=farmer"><i class="ph ph-tractor ico"></i> I'm a Farmer</a>
        <a class="btn btn-accent" href="/signup?role=buyer"><i class="ph ph-shopping-cart ico"></i> I'm a Buyer</a>
      </div>
    </div>
  </div>
    <video id="background-video" autoplay loop muted playsinline preload="metadata" aria-hidden="true">
       <source src="/assets/131457-750569039.mp4" type="video/mp4">
     </video>
</section>

<section class="section">
  <div class="container">
    <h2 class="center">Why AnnaDaan?</h2>
    <div class="grid-3 mt-2">
      <div class="value-card">
        <div class="ico"><i class="ph-fill ph-currency-circle-dollar"></i></div>
        <h3>Better prices, both ways</h3>
        <p class="meta" style="justify-content:center;">Farmers keep more of every sale. Buyers skip the markup that middlemen add.</p>
      </div>
      <div class="value-card">
        <div class="ico"><i class="ph-fill ph-magnifying-glass"></i></div>
        <h3>Clear, honest pricing</h3>
        <p class="meta" style="justify-content:center;">See the farmer's price next to the average market price — no guessing.</p>
      </div>
      <div class="value-card">
        <div class="ico"><i class="ph-fill ph-map-pin"></i></div>
        <h3>Smart delivery hubs</h3>
        <p class="meta" style="justify-content:center;">Every order is matched to the nearest collection hub, with the route on a map.</p>
      </div>
    </div>
  </div>
</section>

<section class="section" style="background:var(--green-soft)">
  <div class="container center">
    <h2>Ready to get started?</h2>
    <p class="lead" style="margin-inline:auto">Join for free and start buying or selling today.</p>
    <div class="hero-cta" style="justify-content:center">
      <a class="btn btn-primary" href="/signup?role=farmer"><i class="ph ph-tractor ico"></i> Sell my produce</a>
      <a class="btn btn-outline" href="/listings"><i class="ph ph-shopping-cart ico"></i> Browse produce</a>
    </div>
  </div>
</section>

<%- include("partials/footer") %>
